# Copy this file to .env and put your own values in it. .env is git-ignored.
# The same values are read by the Spring Boot backend (mock APIs) and by the
# Camunda Connectors runtime, where BPMN models use them as {{secrets.NAME}}.
IAM_API_TOKEN=change-me-iam-token
BGV_API_KEY=change-me-bgv-key
SLACK_BOT_TOKEN=change-me-slack-token
